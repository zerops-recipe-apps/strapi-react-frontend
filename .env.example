# Production / Zerops build (required for `npm run build` deploy artifacts)
# VITE_API_URL=https://your-strapi-host.example.com

# Local dev: leave VITE_API_URL unset and run Strapi on :1337 — Vite proxies /api.
# Or set a full URL if Strapi runs elsewhere (ensure Strapi CORS allows this origin):
# VITE_API_URL=http://127.0.0.1:1337

# Override proxy target when Strapi is not on the default port:
# VITE_STRAPI_PROXY=http://127.0.0.1:1337
